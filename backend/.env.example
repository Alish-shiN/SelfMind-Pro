ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
BACKEND_CORS_ORIGINS='["*"]'

FIREBASE_PROJECT_ID=""
